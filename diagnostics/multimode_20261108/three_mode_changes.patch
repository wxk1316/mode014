+    beta_max: float = math.pi/2
+    beta_rate: float = math.radians(30)
+    beta_accel: float = math.radians(100)
+    v_max: float = .5
+    acc: float = .7
+    dec: float = 1.2
+    jerk: float = 2.
+    direction_acc: float = .6
+
+
