+ poses[:,0]=np.c_[xx,yy,th];vel[:,0]=v;angles[:,0]=b
+ for i in range(1,len(ts)):
+  j=max(0,int(np.searchsorted(ts,ts[i]-delay,side="right")-1))
+  target_v=vt[:,j] if ts[i]>delay else abs(speed);target_b=ds[:,j] if ts[i]>delay else steer
