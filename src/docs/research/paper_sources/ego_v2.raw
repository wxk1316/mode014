              <span id="alg1.l10.3" class="ltx_text ltx_font_bold">for</span> <math id="alg1.l10.m1" class="ltx_Math" alttext="\mathbf{S}_{i}.\text{begin}\leq j\leq\mathbf{S}_{i}.\text{end}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐒</mi><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">.</mo><mrow><mtext>begin</mtext><mo>≤</mo><mi>j</mi><mo>≤</mo><msub><mi>𝐒</mi><mi>i</mi></msub></mrow><mo lspace="0em" rspace="0.167em">.</mo><mtext>end</mtext></mrow><annotation encoding="application/x-tex">\mathbf{S}_{i}.\text{begin}\leq j\leq\mathbf{S}_{i}.\text{end}</annotation></semantics></math> <span id="alg1.l10.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg1.l11" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l11.1" class="ltx_text" style="font-size:80%;">11:</span></span>
              
              
               <math id="alg1.l11.m1" class="ltx_Math" alttext="\{\mathbf{p},\mathbf{v}\}\leftarrow" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><mrow><mi>𝐩</mi><mo>,</mo><mi>𝐯</mi></mrow><mo stretchy="false">}</mo></mrow><mo stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\{\mathbf{p},\mathbf{v}\}\leftarrow</annotation></semantics></math> Find_p_v_Pairs(<math id="alg1.l11.m2" class="ltx_Math" alttext="\mathbf{Q}_{j},\mathbf{\Gamma}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐐</mi><mi>j</mi></msub><mo>,</mo><mi>𝚪</mi></mrow><annotation encoding="application/x-tex">\mathbf{Q}_{j},\mathbf{\Gamma}</annotation></semantics></math>)

</div>
