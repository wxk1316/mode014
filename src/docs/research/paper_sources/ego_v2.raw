<td id="S6.T1.5.5.6" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:0.5pt;padding-bottom:0.5pt;"><span id="S6.T1.5.5.6.1" class="ltx_text ltx_font_bold">22</span></td>
