              <math id="alg1.l9.m1" class="ltx_Math" alttext="\mathbf{\Gamma}\leftarrow" display="inline" intent=":literal"><semantics><mrow><mi>𝚪</mi><mo stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\mathbf{\Gamma}\leftarrow</annotation></semantics></math> PathSearch(<math id="alg1.l9.m2" class="ltx_Math" alttext="\mathcal{E}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℰ</mi><annotation encoding="application/x-tex">\mathcal{E}</annotation></semantics></math>, <math id="alg1.l9.m3" class="ltx_Math" alttext="\mathbf{S_{i}}" display="inline" intent=":literal"><semantics><msub><mi>𝐒</mi><mi>𝐢</mi></msub><annotation encoding="application/x-tex">\mathbf{S_{i}}</annotation></semantics></math>)

</div>
<div id="alg1.l10" class="ltx_listingline">
