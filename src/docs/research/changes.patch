+class RecoveryEvidenceTests(unittest.TestCase):
+    def test_available_ack_command_but_unmoving_vehicle_never_requests_spin(self):
+        c=core();c.set_goal(6.,0.)
+        walls=[(1.32,0.,'static_large',.4,2.,0.,0.,1),(-1.32,0.,'static_large',.4,2.,0.,0.,2)]
+        for i in range(25):
+            now=i*.1;fresh(c,now,walls)
+            info=c.step(now=now)
+            self.assertEqual(info['traj_mode'],0)
+            self.assertFalse(c.trap['active'])
+        self.assertEqual(c._stall_class,'execution_stall')
+        self.assertEqual(c._spin_attempts,0)
