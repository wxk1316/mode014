+"""Independent cross-module geometry and unknown-time contract checks (no ROS)."""
+from pathlib import Path
+import sys,math,copy
+import numpy as np
+ROOT=Path(__file__).resolve().parents[1]
+sys.path[:0]=[str(ROOT/'rda_dwa'),str(ROOT/'rda_dwa_real'),str(ROOT/'tests')]
+from test_planner_safety import planner,core,obstacle
+from rda_dwa_real.obstacle_fusion import TrackManager
+from rda_dwa.predictor import ObstaclePredictor
+from rda_dwa_real.traj_tracker_core import TrajTrackerCore,TrajTrackerParams
+
+def corners(x,y,yaw,L,W):
+ c,s=math.cos(yaw),math.sin(yaw)
+ return [(x+c*u-s*v,y+s*u+c*v) for u,v in ((-L/2,-W/2),(L/2,-W/2),(L/2,W/2),(-L/2,W/2))]
+def point_seg(p,a,b):
+ ab=np.asarray(b)-a;ap=np.asarray(p)-a
+ t=min(1.,max(0.,float(ap@ab)/max(float(ab@ab),1e-15)))
+ return float(np.linalg.norm(np.asarray(p)-(a+t*ab)))
+def inside(p,poly):
+ crosses=[]
+ for a,b in zip(poly,poly[1:]+poly[:1]):
+  crosses.append((b[0]-a[0])*(p[1]-a[1])-(b[1]-a[1])*(p[0]-a[0]))
+ return min(crosses)>=-1e-12 or max(crosses)<=1e-12
+def segment_intersects(a,b,c,d):
+ def cross(x,y,z):return (y[0]-x[0])*(z[1]-x[1])-(y[1]-x[1])*(z[0]-x[0])
+ return (max(min(a[0],b[0]),min(c[0],d[0]))<=min(max(a[0],b[0]),max(c[0],d[0]))+1e-12
+         and max(min(a[1],b[1]),min(c[1],d[1]))<=min(max(a[1],b[1]),max(c[1],d[1]))+1e-12
+         and cross(a,b,c)*cross(a,b,d)<=1e-12 and cross(c,d,a)*cross(c,d,b)<=1e-12)
+def polygon_distance(A,B):
+ if inside(A[0],B) or inside(B[0],A):return 0.
+ if any(segment_intersects(a,b,c,d) for a,b in zip(A,A[1:]+A[:1]) for c,d in zip(B,B[1:]+B[:1])):return 0.
+ return min([point_seg(p,np.asarray(a),np.asarray(b)) for P,Q in ((A,B),(B,A)) for p in P for a,b in zip(Q,Q[1:]+Q[:1])])
+
+def test_batch_static_bounds_and_minimum_do_not_overstate_independent_geometry():
+ a,_=planner();rng=np.random.default_rng(1706)
