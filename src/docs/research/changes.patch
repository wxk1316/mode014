+        walls=[(1.14,0.,'static_large',.4,2.,0.,0.,1),(-1.14,0.,'static_large',.4,2.,0.,0.,2)]
+        target=None
+        for i in range(12):
+            now=i*.1;fresh(c,now,walls)
+            if target is not None:c.set_bridge_state(1)
+            info=c.step(now=now)
+            if info['traj_mode']==1:
+                if target is None:target=info['spin_target']
+                self.assertEqual(info['spin_target'],target)
+                self.assertEqual(info['v_cmd'],0.)
+        self.assertIsNotNone(target)
+        self.assertEqual(c._spin_attempts,1)
+        self.assertTrue(c._spin_safe(target,c._last_obs))
+
+    def test_dynamic_and_unknown_blockage_are_yielding_without_static_evidence(self):
+        for unknown in (False,True):
