+"""Motion-consistency regressions use source-stamped synthetic detections."""
+from pathlib import Path
+import sys
+import math
+import unittest
+import numpy as np
+ROOT=Path(__file__).resolve().parents[1]
+sys.path[:0]=[str(ROOT/'rda_dwa'),str(ROOT/'rda_dwa_real')]
+from rda_dwa_real.kf_tracker import GlobalKFTracker,HungarianMatcher
+from rda_dwa_real.obstacle_fusion import TrackManager,WorldObstacleRepresenter,Clusterer
+from rda_dwa.predictor import ObstaclePredictor
+
+def det(x,y=2):return (x,y,'pedestrian',.3,.3)
+def fusion_det(state):
+ tid,x,y,speed,heading,kind,L,W=state
+ return x,y,kind,L,W,heading,speed,tid,0.0
+
+class MotionGuardTests(unittest.TestCase):
+ def test_impossible_second_displacement_stays_unknown_not_clipped_known(self):
+  t=GlobalKFTracker(dt=.05)
+  t.step([det(2)],stamp=100)
+  out=t.step([det(2.25)],stamp=100.05)[0]
+  self.assertEqual(out[0],1)
+  self.assertEqual(out[5],'unknown')
+  self.assertEqual(out[3],0)
+  self.assertAlmostEqual(out[1],2.25)
+  self.assertEqual(t.tracks[1].motion_status,'speed_bound')
+ def test_gate_rejection_keeps_old_hold_and_new_detection(self):
+  t=GlobalKFTracker(dt=.05,lost_ttl_seconds=.5)
+  t.step([det(2)],stamp=100)
+  out=t.step([det(2.8)],stamp=100.05)
+  self.assertEqual(len(out),2)
+  self.assertEqual(t.last_detection_ids,{0:2})
+  self.assertTrue(all(o[5]=='unknown' for o in out))
+  self.assertTrue(any(abs(o[1]-2.8)<1e-8 for o in out))
+  self.assertEqual(len(t.step([det(2.8)],stamp=100.6)),1)
+ def test_valid_constant_velocity_and_irregular_real_dt_are_preserved(self):
+  t=GlobalKFTracker(dt=.05)
+  t.step([det(2)],stamp=100)
+  for elapsed in (.1,.18,.3,.39,.5):
+   out=t.step([det(2-elapsed)],stamp=100+elapsed)[0]
+   self.assertEqual(out[0],1)
+   self.assertEqual(out[5],'pedestrian')
+   self.assertAlmostEqual(out[3],1,delta=.05)
+   self.assertAlmostEqual(abs(out[4]),math.pi,delta=.01)
+ def test_abrupt_reversal_resets_unknown_then_reconfirms(self):
+  t=GlobalKFTracker(dt=.1)
+  for i in range(8):out=t.step([det(2+i*.1)],stamp=100+i*.1)[0]
+  self.assertAlmostEqual(out[3],1,delta=.02)
+  out=t.step([det(2.6)],stamp=100.8)[0]
+  self.assertEqual(out[5],'unknown')
+  self.assertEqual(out[3],0)
+  self.assertFalse(t.tracks[1].static_confirmed)
+  for i in range(1,4):out=t.step([det(2.6-i*.1)],stamp=100.8+i*.1)[0]
+  self.assertEqual(out[5],'pedestrian')
+  self.assertAlmostEqual(abs(out[4]),math.pi,delta=.01)
+ def test_unknown_motion_survives_fusion_and_duplicate_source(self):
+  t=GlobalKFTracker(dt=.05)
+  f=TrackManager(ObstaclePredictor(dt=.1),max_speed=1.5)
+  first=t.step([det(2)],stamp=100)[0]
+  f.update_measurements([fusion_det(first)],now=10,stamp=100)
+  bad=t.step([det(2.25)],stamp=100.05)[0]
+  got=f.update_measurements([fusion_det(bad)],now=10.05,stamp=100.05)[0]
+  self.assertTrue(got.velocity_unknown)
+  before=t.tracks[1].x.copy()
+  t.step([det(1)],stamp=100.05)
+  np.testing.assert_array_equal(before,t.tracks[1].x)
+  aged=f.snapshot(10.25)[0]
+  self.assertGreaterEqual(aged.radius,got.radius+1.5*.2)
+ def test_tiled_reversal_inherits_unknown_parent(self):
+  r=WorldObstacleRepresenter()
+  for i in range(8):
+   raw=[(2+i*.1+j*.05,2) for j in range(80)]
+   out=r.step(Clusterer().cluster(raw),100+i*.1)
+  self.assertTrue(all(o[5]=='pedestrian' for o in out))
+  raw=[(2.6+j*.05,2) for j in range(80)]
+  out=r.step(Clusterer().cluster(raw),100.8)
+  self.assertTrue(all(o[5]=='unknown' and o[3]==0 for o in out))
+  for x,y in raw:
+   self.assertTrue(any(abs(x-o[1])<=o[6]/2+1e-8 and abs(y-o[2])<=o[7]/2+1e-8 for o in out))
+ def test_motion_guard_disable_provides_algorithm_ablation(self):
+  t=GlobalKFTracker(dt=.05,motion_guard_enable=False)
+  t.step([det(2)],stamp=100)
+  out=t.step([det(2.25)],stamp=100.05)[0]
+  self.assertEqual(out[5],'pedestrian')
+  self.assertAlmostEqual(out[3],1.5)
+ def test_late_single_measurement_does_not_complete_reconfirmation(self):
+  t=GlobalKFTracker(dt=.05,lost_ttl_seconds=.6)
+  t.step([det(2)],stamp=100)
+  t.step([det(2.25)],stamp=100.05)
+  t.step([det(2.25)],stamp=100.1)
+  out=t.step([det(2.25)],stamp=100.5)[0]
+  self.assertEqual(out[5],'unknown')
+  self.assertFalse(t.tracks[1].velocity_trusted)
+ def test_high_rate_centroid_noise_does_not_stay_unknown_forever(self):
+  t=GlobalKFTracker(dt=.05)
+  rng=np.random.default_rng(20261106)
+  kinds=[]
+  for i in range(100):
+   out=t.step([det(2+rng.normal(0,.04),2+rng.normal(0,.04))],stamp=100+i*.05)[0]
+   kinds.append(out[5])
+  self.assertLess(kinds.count('unknown'),20)
+  self.assertEqual(kinds[-1],'block')
+ def test_mask_applies_in_hungarian_and_greedy_fallback(self):
+  import rda_dwa_real.kf_tracker as module
+  original=module._HAS_SCIPY
+  try:
+   for fast in (True,False):
+    module._HAS_SCIPY=fast and module.linear_sum_assignment is not None
+    matched,unmatched=HungarianMatcher(1).match([(0,0)],[(.1,0)],allowed=np.array([[False]]))
+    self.assertEqual(matched,[]);self.assertEqual(unmatched,[0])
+  finally:module._HAS_SCIPY=original
+ def test_bad_operating_bound_parameters_rejected(self):
+  for kwargs in ({'max_speed':float('nan')},{'measurement_position_slack':-1},
+                 {'velocity_innovation_limit':0},{'velocity_reconfirm_time':-1}):
+   with self.assertRaises(ValueError):GlobalKFTracker(**kwargs)
+
+if __name__=='__main__':unittest.main()
