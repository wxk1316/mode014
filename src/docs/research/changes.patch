+"""User-confirmed partial mode semantics must not enable unverified hardware."""
+import math
+from test_planner_safety import planner
+from rda_dwa.robot_model import RobotState
+from rda_dwa.hybrid_primitives import DEFAULT_PROTOCOLS, evaluate_maneuver
+
+
+def test_crab_45_degree_limit_applies_to_both_simulation_directions():
+    model, _ = planner()
+    for direction in (-1, 1):
+        allowed = evaluate_maneuver(model.cc, RobotState(), [], mode='CRAB',
+            translation_angle=direction*math.radians(45), simulation=True)
+        rejected = evaluate_maneuver(model.cc, RobotState(), [], mode='CRAB',
+            translation_angle=direction*math.radians(46), simulation=True)
+        assert allowed.safe and not allowed.protocol_verified
+        assert rejected.status == 'angle_limit' and not rejected.safe
+
+
+def test_partial_speed_angle_confirmation_does_not_invent_ready_ids():
+    for mode in ('CRAB', 'TRANSLATE'):
+        protocol = DEFAULT_PROTOCOLS[mode]
+        assert protocol.speed_unit == 'm/s'
+        assert protocol.command_mode is None and protocol.feedback_mode is None
+        assert not protocol.verified and not protocol.enabled
+    assert DEFAULT_PROTOCOLS['CRAB'].angle_unit == 'degree'
+    assert DEFAULT_PROTOCOLS['TRANSLATE'].angle_unit == 'unused'
