+def recovery(phase='RETREAT'):
+ c=core();c.set_goal(6.,0.);c._activate_trap(c.robot,[],c._goal)
+ c.trap.update(recovery_phase=phase,sub_goal=(-3.,0.),escape_heading=math.pi,
+               rear_heading=0.,phase_spin_started=False,phase_spin_result=None)
+ c._arbit='ACK';c._abort_once=False
+ return c
+
+def test_unknown_and_dynamic_yield_do_not_consume_recovery_budget():
+ for kind in ('unknown','moving'):
+  c=recovery();o=obstacle(8,5,kind='pedestrian',speed=.2 if kind=='moving' else 0.)
+  o.velocity_unknown=kind=='unknown';o.max_unknown_speed=1.5
+  before=c._trap_elapsed
+  c._update_trap([o],.2)
+  assert c._trap_elapsed==before
+  assert c.trap['active'] and c.trap['recovery_phase']=='RETREAT'
+
+def test_repeated_planner_deadlines_do_not_become_trap_timeout():
+ c=recovery();c.cfg.trap_max_duration=.15
+ c.planner.last_failure_reason='deadline'
+ c.planner.last_has_motion=False
+ observations=[(5.,5.,'block',.3,.3,0.,0.,1)]
+ with patch.object(c,'_update_static_detour',return_value=None), \
+      patch.object(c.planner,'plan',return_value=(False,0.,0.)):
+  for i in range(1,5):
+   now=i*.1;fresh(c,now,observations)
+   info=c.step(now=now)
+   assert info['reason']=='planner_budget_timeout'
+   assert info['v_cmd']==0 and info['w_cmd']==0
+   assert c.trap['active'] and not c._episode_failed
+ assert c._trap_elapsed==0.
+
+def test_faulted_source_data_cannot_start_retreat_or_consume_budget():
+ c=recovery();fresh(c,0,[(5.,5.,'block',.3,.3,0.,0.,1)])
+ before=c._trap_elapsed
+ info=c.step(now=1.)
+ assert info['v_cmd']==0 and info['w_cmd']==0
+ assert info['reason'] in ('localization_timeout','obstacle_timeout')
+ assert c._trap_elapsed==before and c._spin_attempts==0
