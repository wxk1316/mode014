+   o=obstacle(*rng.uniform(-8,8,2),length=float(rng.uniform(.05,2)),width=float(rng.uniform(.05,2)),kind='block',id_=i)
+   o.shape_heading=0. if i%2 else float(rng.uniform(-math.pi,math.pi));obs.append(o)
+  bounds=a.cc.temporal_gaps_many(poses,times,obs)
+  L,W,_=a.cc._rect_dims();hb=a.cc._rect_hb()
+  for i,pose in enumerate(poses):
+   x,y,th=pose;A=corners(x+hb*math.cos(th),y+hb*math.sin(th),th,L,W)
+   for j,o in enumerate(obs):
+    exact=polygon_distance(A,corners(o.x,o.y,o.shape_heading,o.length,o.width))
+    assert bounds[i,j]<=exact+1e-10
+  assert math.isclose(a.cc.min_temporal_gap(poses,times,obs),float(np.min(bounds)),abs_tol=1e-10)
