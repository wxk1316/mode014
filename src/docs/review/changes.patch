+class PoseContinuityGuard:
+    """A map correction must never be interpreted as physical motion or spin completion.
+
+    A violation latches until this guard is recreated with the restarted local stack.
+    """
+    def __init__(self, speed_limit=0.8, yaw_rate_limit=0.8,
+                 position_margin=0.15, yaw_margin_deg=5.0):
+        values = (speed_limit, yaw_rate_limit, position_margin, yaw_margin_deg)
+        if (not all(math.isfinite(v) for v in values)
+                or speed_limit <= 0 or yaw_rate_limit <= 0
+                or position_margin < 0 or yaw_margin_deg < 0):
+            raise ValueError('Invalid pose continuity limits')
+        self.speed_limit = speed_limit
+        self.yaw_rate_limit = yaw_rate_limit
+        self.position_margin = position_margin
+        self.yaw_margin = math.radians(yaw_margin_deg)
+        self.last_pose = None
+        self.last_stamp = None
+        self.latched = False
+        self.reason = ''
+
+    def accept(self, pose, source_stamp):
+        if self.latched:
+            return False
+        if not all(math.isfinite(v) for v in (*pose, source_stamp)):
+            self.latched, self.reason = True, 'invalid_pose_continuity_input'
+            return False
+        if self.last_stamp is not None:
+            dt = source_stamp-self.last_stamp
+            if dt <= 0:
+                return False
+            # Long input gaps cannot grant an unlimited map-jump allowance.
+            dt = min(dt, 1.0)
+            displacement = math.hypot(pose[0]-self.last_pose[0], pose[1]-self.last_pose[1])
+            yaw_change = abs(wrap_angle(pose[2]-self.last_pose[2]))
+            if displacement > self.speed_limit*dt+self.position_margin:
+                self.latched, self.reason = True, 'localization_position_jump'
+                return False
+            if yaw_change > self.yaw_rate_limit*dt+self.yaw_margin:
+                self.latched, self.reason = True, 'localization_yaw_jump'
+                return False
+        self.last_pose, self.last_stamp = tuple(pose), source_stamp
+        return True
