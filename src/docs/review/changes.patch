+def rectangle_points(x, y, yaw, length, width):
+    co, si = math.cos(yaw), math.sin(yaw)
+    return [(x+co*dx-si*dy, y+si*dx+co*dy) for dx, dy in ((length/2,width/2),(length/2,-width/2),(-length/2,-width/2),(-length/2,width/2))]
+
+
+def point_segment_distance(point, a, b):
+    dx, dy = b[0]-a[0], b[1]-a[1]
+    denominator = dx*dx+dy*dy
+    fraction = max(0., min(1., ((point[0]-a[0])*dx+(point[1]-a[1])*dy)/denominator)) if denominator else 0.
+    return math.hypot(point[0]-a[0]-fraction*dx, point[1]-a[1]-fraction*dy)
+
+
+def signed_rect_gap(a, b, yaw_a, yaw_b):
+    gap = -math.inf
+    for angle in (yaw_a, yaw_a+math.pi/2, yaw_b, yaw_b+math.pi/2):
+        axis = math.cos(angle), math.sin(angle)
+        aa, bb = [x*axis[0]+y*axis[1] for x,y in a], [x*axis[0]+y*axis[1] for x,y in b]
+        gap = max(gap, max(min(bb)-max(aa), min(aa)-max(bb)))
+    if gap <= 0:
+        return gap
+    return min(point_segment_distance(point, polygon[i], polygon[(i+1)%4])
+               for points, polygon in ((a,b),(b,a)) for point in points for i in range(4))
+
+
+def cv_rectangle_ttc(dx, dy, rvx, rvy, ego_yaw, obs_yaw, ego_length, ego_width, obs_length, obs_width):
+    enter, leave = 0., math.inf
+    for angle in (ego_yaw, ego_yaw+math.pi/2, obs_yaw, obs_yaw+math.pi/2):
+        ax, ay = math.cos(angle), math.sin(angle)
+        half = (ego_length/2*abs(math.cos(angle-ego_yaw))+ego_width/2*abs(math.sin(angle-ego_yaw))
+                +obs_length/2*abs(math.cos(angle-obs_yaw))+obs_width/2*abs(math.sin(angle-obs_yaw)))
+        position, velocity = dx*ax+dy*ay, rvx*ax+rvy*ay
+        if abs(velocity) <= 1e-9:
+            if abs(position) > half:
+                return None
+        else:
+            first, last = sorted(((-half-position)/velocity, (half-position)/velocity))
+            enter, leave = max(enter, first), min(leave, last)
+        if leave < enter:
+            return None
+    return enter if leave >= 0 else None
+
