+def derive_pose_motion(previous, current, source_ns, epoch, source_health):
+    result = {'valid': False, 'source_dt': None, 'vx': None, 'vy': None, 'yaw_rate': None,
+              'method': 'new_source_pose_difference', 'not_instrumented_velocity_feedback': True}
+    if not current.get('quaternion_valid') or contains_invalid(current) or source_health['progress'] != 'new' or not source_health['age_valid'] or any(source_health.get(k,False) for k in ('future','stale','payload_invalid')):
+        return result
+    if previous and previous.get('valid') is True and previous['epoch'] == epoch:
+        dt = (source_ns-previous['source_ns'])*1e-9
+        if 0 < dt <= 1.:
+            dyaw = (current['theta']-previous['pose']['theta']+math.pi)%(2*math.pi)-math.pi
+            result.update(valid=True, source_dt=dt, vx=(current['x']-previous['pose']['x'])/dt,
+                          vy=(current['y']-previous['pose']['y'])/dt, yaw_rate=dyaw/dt)
+    return result
+
+
+def command_derivatives(previous, current, received_ns, deadband=.5):
+    result = {'dt': None, 'speed_rate': None, 'angle_rate_deg_s': None, 'steer_sign_flip': False,
+              'speed_sign_flip': False, 'measured_steering': False, 'command_units': 'rad/s' if current.get('turnmode') == 4 else 'm/s'}
+    if previous is None or previous['payload'].get('turnmode') != current.get('turnmode'):
+        return result
+    dt = (received_ns-previous['received_ns'])*1e-9
+    old = previous['payload']
+    if dt > 0 and all(math.isfinite(float(p.get(k, math.nan))) for p in (old, current) for k in ('speed', 'angle')):
+        result.update(dt=dt, speed_rate=(current['speed']-old['speed'])/dt,
+                      angle_rate_deg_s=(current['angle']-old['angle'])/dt,
+                      steer_sign_flip=old['angle']*current['angle'] < 0 and min(abs(old['angle']), abs(current['angle'])) >= deadband,
+                      speed_sign_flip=old['speed']*current['speed'] < 0)
+    return result
+
