+sys.path.insert(0,str(Path(__file__).resolve().parents[1]/'rda_dwa_real'))
+from rda_dwa_real import diag_recorder_node as diag
+NS=types.SimpleNamespace
+BASE_NS=1800000000123456789
+
+
+def header(ns=BASE_NS,frame='map'):
+    return NS(stamp=NS(sec=ns//1000000000,nanosec=ns%1000000000),frame_id=frame)
+
+
+def pose(x=0.,y=0.,yaw=0.):
+    return NS(position=NS(x=x,y=y,z=0.),orientation=NS(x=0.,y=0.,z=math.sin(yaw/2),w=math.cos(yaw/2)))
+
+
+def odom(ns=BASE_NS,x=0.,y=0.,yaw=0.):
+    vector=NS(x=0.,y=0.,z=0.)
+    return NS(header=header(ns),child_frame_id='body',pose=NS(pose=pose(x,y,yaw),covariance=[0.]*36),
+              twist=NS(twist=NS(linear=vector,angular=vector),covariance=[0.]*36))
+
+
+def fake_ros(overrides):
+    class Node:
+        def __init__(self,name):
+            self.values={};self.ros_ns=BASE_NS;self.subscriptions=[];self.timers=[]
+        def declare_parameter(self,name,default): self.values[name]=overrides.get(name,default)
+        def get_parameter(self,name): return NS(value=self.values[name])
+        def create_subscription(self,typ,topic,callback,qos):
+            result=NS(typ=typ,topic=topic,callback=callback,qos=qos);self.subscriptions.append(result);return result
+        def create_publisher(self,*args): raise AssertionError('Recorder must never publish')
+        def create_timer(self,period,callback): self.timers.append((period,callback))
+        def get_clock(self): return NS(now=lambda:NS(nanoseconds=self.ros_ns))
+        def get_logger(self): return NS(info=lambda _:None)
+        def destroy_node(self): return True
+    modules={}
+    for name in ('rclpy','rclpy.node','rclpy.qos','nav_msgs','nav_msgs.msg','geometry_msgs','geometry_msgs.msg',
+                 'std_msgs','std_msgs.msg','sensor_msgs','sensor_msgs.msg','control_msgs','control_msgs.msg',
+                 'rda_dwa_real_msgs','rda_dwa_real_msgs.msg','rcl_interfaces','rcl_interfaces.msg'):
+        modules[name]=types.ModuleType(name)
+    modules['rclpy.node'].Node=Node
+    modules['rclpy.qos'].QoSProfile=lambda **kw:NS(**kw)
+    for name,values in [('DurabilityPolicy',{'VOLATILE':'VOLATILE'}),
+                        ('ReliabilityPolicy',{'RELIABLE':'RELIABLE','BEST_EFFORT':'BEST_EFFORT'}),
+                        ('HistoryPolicy',{'KEEP_LAST':'KEEP_LAST'})]:
+        setattr(modules['rclpy.qos'],name,NS(**values))
+    for module,names in [('nav_msgs.msg',('Odometry','Path')),('geometry_msgs.msg',('Twist','TwistStamped','PoseStamped','PoseWithCovarianceStamped')),
+                         ('std_msgs.msg',('Float32','Int32','String')),('sensor_msgs.msg',('PointCloud2','NavSatFix')),
+                         ('control_msgs.msg',('CarCtr','CarState')),('rda_dwa_real_msgs.msg',('ObstacleArray',)),
+                         ('rcl_interfaces.msg',('ParameterEvent',))]:
+        for name in names: setattr(modules[module],name,type(name,(),{}))
+    return modules
