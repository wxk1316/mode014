+def planner():
+    p = module_config('v15_latesc')
+    p.real_vehicle_safety = True
+    p.max_linear_velocity, p.min_linear_velocity = .4, -.3
+    p.min_angular_velocity, p.max_angular_velocity = -.7, .7
+    p.acc_lin_max, p.dec_lin_max = .5, 1.5
+    p.safety_margin, p.safety_dt = .2, .05
+    p.alpha_smooth = .6
+    p.enable_mpt_escape = p.backup_enabled = False
+    ap = AckermannParams(length=1.2, width=.8, wheelbase=.69,
+        delta_max=math.radians(30), delta_dot_max=math.radians(45),
+        v_min=-.3, v_max=.4, a_max=.5, dec_max=1.5, footprint_center_offset=0.,reference_rear_offset=-.345)
+    return EnhancedDWA(p, 'ENHANCED_DWA', 'rectangle', ack_params=ap), ap
