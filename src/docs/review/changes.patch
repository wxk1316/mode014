+def _telemetry_clean(value):
+    """Strict JSON values; retain integer nanoseconds without float conversion."""
+    if value is None or isinstance(value, (str, bool, int)):
+        return value
+    if isinstance(value, float):
+        return value if math.isfinite(value) else None
+    if isinstance(value, dict):
+        return {str(k): _telemetry_clean(v) for k, v in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [_telemetry_clean(v) for v in value]
+    # Runtime arrays are never copied into telemetry; numeric scalars may be numpy types.
+    if hasattr(value, 'item'):
+        return _telemetry_clean(value.item())
+    return None
+
+
+def _telemetry_age(now, received):
+    return now-received if received is not None and math.isfinite(received) else None
+
