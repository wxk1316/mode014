+def vector_dict(vector):
+    return {axis: float(getattr(vector, axis, 0.)) for axis in ('x', 'y', 'z')}
+
+
+def pose_payload(pose):
+    position = vector_dict(pose.position)
+    quaternion = {axis: float(getattr(pose.orientation, axis, 0.)) for axis in ('x', 'y', 'z', 'w')}
+    q = quaternion
+    yaw = math.atan2(2*(q['w']*q['z']+q['x']*q['y']), 1-2*(q['y']**2+q['z']**2))
+    norm = math.hypot(*q.values())
+    return {'position': position, 'quaternion': quaternion, 'x': position['x'], 'y': position['y'],
+            'z': position['z'], 'theta': yaw, 'quaternion_valid': math.isfinite(norm) and abs(norm-1) < .05}
+
+
+def message_to_dict(msg):
+    """For small structured messages only; never called on PointCloud2.data."""
+    if msg is None or isinstance(msg, (int, str, float, bool)):
+        return msg
+    if isinstance(msg, (list, tuple, array.array)):
+        return [message_to_dict(v) for v in msg]
+    if hasattr(msg,'tolist'):
+        return message_to_dict(msg.tolist())
+    if isinstance(msg, (bytes, bytearray, memoryview)):
+        return [int(v) for v in msg]
+    fields = msg.get_fields_and_field_types().keys() if hasattr(msg, 'get_fields_and_field_types') else vars(msg).keys() if hasattr(msg, '__dict__') else []
+    return {name: message_to_dict(getattr(msg, name)) for name in fields if not name.startswith('_')}
+
+
+def extract_payload(key, msg):
+    if key in ('loc', 'odometry', 'map_to_odom'):
+        payload = pose_payload(msg.pose.pose)
+        payload.update({'child_frame': getattr(msg, 'child_frame_id', ''),
+                        'pose_covariance': list(getattr(msg.pose, 'covariance', [])),
+                        'twist': {'linear': vector_dict(msg.twist.twist.linear), 'angular': vector_dict(msg.twist.twist.angular)},
+                        'twist_covariance': list(getattr(msg.twist, 'covariance', []))})
+        return payload
+    if key == 'initialpose':
+        payload = pose_payload(msg.pose.pose)
+        payload['pose_covariance'] = list(getattr(msg.pose, 'covariance', []))
+        return payload
+    if key in ('command', 'cmd_vel'):
+        twist = msg.twist if key == 'command' else msg
+        return {'v': float(twist.linear.x), 'w': float(twist.angular.z),
+                'linear': vector_dict(twist.linear), 'angular': vector_dict(twist.angular),
+                'epoch_ns': stamp_ns(getattr(msg, 'header', None)) if key == 'command' else None}
+    if key == 'traj':
+        points = []
+        for item in msg.poses:
+            point = pose_payload(item.pose)
+            points.append({'x': point['x'], 'y': point['y'], 'z': point['z'], 'yaw': point['theta'],
+                           'quaternion': point['quaternion'], 'quaternion_valid': point['quaternion_valid'],
+                           'speed_label': point['z'], 'stamp_ns': stamp_ns(item.header), 'frame': item.header.frame_id})
+        arc = sum(math.hypot(b['x']-a['x'], b['y']-a['y']) for a, b in zip(points, points[1:]))
+        return {'n_pts': len(points), 'arc_len': arc, 'points': points,
+                'epoch_ns': stamp_ns(msg.header), 'speed_label_is_reference_not_feedback': True}
+    if key == 'cloud':
+        return {'frame': msg.header.frame_id, 'height': int(msg.height), 'width': int(msg.width),
+                'n_points': int(msg.height)*int(msg.width), 'point_step': int(msg.point_step),
+                'row_step': int(msg.row_step), 'is_bigendian': bool(msg.is_bigendian),
+                'is_dense': bool(msg.is_dense), 'data_bytes': len(msg.data),
+                'fields': [{'name': f.name, 'offset': int(f.offset), 'datatype': int(f.datatype), 'count': int(f.count)} for f in msg.fields],
+                'data_omitted': True}
+    if key == 'obstacles':
+        objects = [message_to_dict(ob) for ob in msg.obstacles]
+        return {'n': len(objects), 'objects': objects}
+    if key == 'car_cmd':
+        return {name: getattr(msg, name) for name in ('enable', 'turnmode', 'speed', 'angle', 'ctr_mode', 'source', 'up_down_flag', 'heartbeat')}
+    if key == 'car_state':
+        values = [float(v) for v in msg.speed]
+        valid_count = sum(math.isfinite(v) for v in values)
+        return {'enable': int(msg.enable), 'ctrmode': int(msg.ctrmode), 'turnmode': int(msg.turnmode),
+                'speeds': values, 'speed_mean': sum(values)/4 if len(values) == valid_count == 4 else None,
+                'valid_count': valid_count, 'wheel_speed_valid': len(values) == valid_count == 4,
+                'errcode': [int(v) for v in msg.errcode], 'actual_steering_available': False,
+                'wheel_source_age_available': False}
+    if key in ('ctrl_status', 'rda_status', 'diag'):
+        data = str(msg.data)
+        if key == 'diag':
+            try:
+                parsed = json.loads(data)
+                error = not isinstance(parsed, dict)
+            except (ValueError, TypeError):
+                parsed, error = None, True
+        else:
+            parsed, error = parse_kv_string(data), False
+        return {'data': data, 'parsed': parsed, 'parse_error': error}
+    if key == 'goal':
+        return pose_payload(msg.pose)
+    if key == 'gps':
+        return {'lat': float(msg.latitude), 'lon': float(msg.longitude), 'alt': float(msg.altitude)}
+    if key in ('spin_target', 'traj_mode', 'bridge_state', 'mode_ready'):
+        return {'data': msg.data}
+    return message_to_dict(msg)
