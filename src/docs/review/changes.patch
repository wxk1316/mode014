+def obstacle_geometry_summary(objects, localization, obstacle_frame=None, length=1.2, width=.8, source_fresh=False, source_stale_timeout=.5):
+    result = {'method': 'map AABB obstacles / oriented vehicle footprint; constant velocity fixed yaw TTC estimate',
+              'is_safety_proof': False, 'vehicle_length': length, 'vehicle_width': width,
+              'objects': [], 'sectors': {k: {'min_ttc_s': None, 'min_gap': None, 'unknown_count': 0, 'no_collision_count': 0} for k in ('front','back','left','right')},
+              'status': 'unknown'}
+    if not localization or localization.get('quaternion_valid') is False or contains_invalid(localization) or obstacle_frame != localization.get('frame'):
+        return result
+    x,y,yaw = localization.get('x'),localization.get('y'),localization.get('theta')
+    if not all(isinstance(v,(int,float)) and math.isfinite(v) for v in (x,y,yaw)):
+        return result
+    if 'source_age' in localization:
+        age = localization.get('source_age')
+        source_fresh = source_fresh and isinstance(age,(int,float)) and math.isfinite(age) and 0 <= age <= source_stale_timeout
+    result['status'] = 'fresh_estimate' if source_fresh else 'stale_geometry_only'
+    ego = rectangle_points(x,y,yaw,length,width)
+    motion = localization.get('last_valid_derived') or localization.get('derived') or {}
+    if localization.get('last_valid_derived') and not localization.get('last_valid_derived_fresh',False):
+        motion = {}
+    for ob in objects:
+        required = ('x','y','length','width','heading')
+        if not all(isinstance(ob.get(k),(int,float)) and math.isfinite(ob[k]) for k in required):
+            continue
+        dx,dy = ob['x']-x,ob['y']-y
+        xr,yr = dx*math.cos(yaw)+dy*math.sin(yaw),-dx*math.sin(yaw)+dy*math.cos(yaw)
+        sector = ('front' if xr>=0 else 'back') if abs(xr)>=abs(yr) else ('left' if yr>=0 else 'right')
+        gap,ttc,status = None,None,'unknown'
+        if ob['length']>0 and ob['width']>0:
+            gap = signed_rect_gap(ego,rectangle_points(ob['x'],ob['y'],0.,ob['length'],ob['width']),yaw,0.)
+            speed = ob.get('speed')
+            velocity_unknown = bool(ob.get('velocity_unknown')) or str(ob.get('type','unknown')).lower() == 'unknown'
+            if source_fresh and not velocity_unknown and motion.get('valid') and isinstance(speed,(int,float)) and math.isfinite(speed) and speed>=0:
+                ttc = cv_rectangle_ttc(dx,dy,speed*math.cos(ob['heading'])-motion['vx'],speed*math.sin(ob['heading'])-motion['vy'],yaw,0.,length,width,ob['length'],ob['width'])
+                status = 'collision_estimate' if ttc is not None else 'no_collision_constant_velocity'
+        item = {'id':ob.get('id'),'type':ob.get('type'),'sector':sector,'center_distance':math.hypot(dx,dy),
+                'body_x':xr,'body_y':yr,'footprint_gap':gap,'obstacle_geometry_yaw':0.,'motion_heading':ob['heading'],'ttc_s':ttc,'ttc_status':status}
+        result['objects'].append(item)
+        bucket = result['sectors'][sector]
+        if gap is not None:
+            bucket['min_gap'] = gap if bucket['min_gap'] is None else min(gap,bucket['min_gap'])
+        if ttc is not None:
+            bucket['min_ttc_s'] = ttc if bucket['min_ttc_s'] is None else min(ttc,bucket['min_ttc_s'])
+        elif status == 'unknown':
+            bucket['unknown_count'] += 1
+        else:
+            bucket['no_collision_count'] += 1
+    return result
+
