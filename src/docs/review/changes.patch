+class SourceArrivalHealth:
+    """ROS source age and monotonic arrival age have separate clock domains."""
+    def __init__(self, rate_window=2., stale_timeout=.5, jump_threshold=.5):
+        for value in (rate_window, stale_timeout, jump_threshold):
+            if not math.isfinite(value) or value <= 0:
+                raise ValueError('Timing windows must be finite and positive')
+        self.window, self.stale, self.jump = rate_window, stale_timeout, jump_threshold
+        self.topics = {}
+        self.epoch = 0
+        self.clock_valid = True
+        self.stable_intervals = 0
+        self.last_clock = None
+        self.clock_jumps = 0
+
+    def clock(self, ros_ns, mono_ns):
+        changed = False
+        if self.last_clock:
+            prev_ros, prev_mono = self.last_clock
+            delta_ros, delta_mono = ros_ns-prev_ros, mono_ns-prev_mono
+            if delta_ros < 0 or abs(delta_ros-delta_mono) > self.jump*1e9:
+                self.epoch += 1
+                self.clock_jumps += 1
+                self.clock_valid = False
+                self.stable_intervals = 0
+                changed = True
+                for state in self.topics.values():
+                    state['last_stamp'] = None
+            elif not self.clock_valid:
+                self.stable_intervals += 1
+                if self.stable_intervals >= 2:
+                    self.clock_valid = True
+        self.last_clock = (ros_ns, mono_ns)
+        return changed
+
+    def observe(self, key, source_ns, has_header, ros_ns, mono_ns, payload_invalid=False):
+        changed = self.clock(ros_ns, mono_ns)
+        state = self.topics.setdefault(key, {'arrival': deque(), 'progress': deque(), 'valid_progress': deque(),
+            'last_stamp': None, 'last_source': None, 'last_arrival': None, 'epoch': self.epoch,
+            'counts': {k: 0 for k in ('arrivals', 'new', 'duplicate', 'backward', 'invalid', 'unstamped', 'future', 'stale', 'invalid_payload')}})
+        for series in ('arrival','progress','valid_progress'):
+            while state[series] and mono_ns-state[series][0] > self.window*1e9:
+                state[series].popleft()
+        state['arrival'].append(mono_ns)
+        state['last_arrival'] = mono_ns
+        state['epoch'] = self.epoch
+        state['last_source'] = source_ns
+        counts = state['counts']
+        counts['arrivals'] += 1
+        if not has_header:
+            progress = 'unstamped'
+        elif source_ns is None or source_ns <= 0:
+            progress = 'invalid'
+        elif state['last_stamp'] is None or source_ns > state['last_stamp']:
+            progress = 'new'
+            state['last_stamp'] = source_ns
+            state['progress'].append(mono_ns)
+        elif source_ns == state['last_stamp']:
+            progress = 'duplicate'
+        else:
+            progress = 'backward'
