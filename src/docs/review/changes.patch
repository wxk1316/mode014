+def mode_consistency(command_mode, feedback_mode, ready_mode, elapsed, min_wait=3., timeout=8., fresh=True):
+    result = {'status': 'unknown', 'command_mode': command_mode, 'feedback_mode': feedback_mode,
+              'ready_mode': ready_mode, 'elapsed_s': elapsed, 'min_wait_s': min_wait, 'deadline_s': timeout,
+              'steering_feedback_available': False}
+    if command_mode not in (0,4) or elapsed is None:
+        return result
+    if not fresh:
+        result['status'] = 'feedback_or_ready_stale'
+    elif ready_mode == command_mode and feedback_mode == command_mode:
+        result['status'] = 'ready'
+    elif ready_mode == command_mode and feedback_mode is not None and feedback_mode != command_mode:
+        result['status'] = 'ready_feedback_mismatch'
+    elif elapsed < min_wait:
+        result['status'] = 'normal_switch_wait'
+    elif elapsed <= timeout:
+        result['status'] = 'awaiting_ready_within_deadline'
+    else:
+        result['status'] = 'switch_deadline_exceeded'
+    return result
