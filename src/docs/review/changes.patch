+def code_fingerprints():
+    def fingerprint(path, missing='missing'):
+        result = {'path':str(path) if path else None, 'status':missing, 'sha256':None}
+        try:
+            raw = Path(path).read_bytes()
+            result.update(status='present',sha256=hashlib.sha256(raw).hexdigest(),bytes=len(raw))
+        except Exception as exc:
+            result['error'] = f'{type(exc).__name__}: {exc}'
+        return result
+    directory = Path(__file__).resolve().parent
+    files = {name:fingerprint(directory/name) for name in
+        ('diag_recorder_node.py','bridge_node.py','traj_tracker_node.py','traj_tracker_core.py',
+         'lidar_track_node.py','kf_tracker.py','frame_utils.py','obstacle_fusion.py')}
+    for name in ('enhanced_dwa','collision_checker','escape','params','ackermann_model','predictor','trial_runner'):
+        module = 'rda_dwa.'+name
+        try:
+            spec = importlib.util.find_spec(module)
+            files[module] = fingerprint(spec.origin if spec and spec.origin else None)
+        except Exception as exc:
+            files[module] = {'path':None,'status':'missing','sha256':None,'error':f'{type(exc).__name__}: {exc}'}
+    try:
+        from ament_index_python.packages import get_package_prefix
