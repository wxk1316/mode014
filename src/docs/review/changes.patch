+def oriented_box_aabb(length, width, yaw):
+    """Map-aligned dimensions enclosing an oriented box at the same center."""
+    c, s = abs(math.cos(yaw)), abs(math.sin(yaw))
+    return c*length+s*width, s*length+c*width
