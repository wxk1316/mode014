+    def path(self,ns=0,sec=100):
+        return NS(header=self.header(ns,sec),poses=[NS(pose=NS(position=NS(x=i*.02,y=0.),orientation=NS(x=0.,y=0.,z=0.,w=1.))) for i in range(60)])
+    def loc(self,sec=100):
