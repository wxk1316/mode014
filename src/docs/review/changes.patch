+class BackgroundJsonlWriter:
+    """Persistent files, bounded non-blocking producer; this class opens no network."""
+    def __init__(self, directory, queue_capacity=4096, max_segment_bytes=128*1024*1024,
+                 flush_interval=1., close_timeout=5.):
+        if (isinstance(queue_capacity, bool) or int(queue_capacity) != queue_capacity or queue_capacity <= 0
+                or max_segment_bytes <= 0 or not math.isfinite(flush_interval) or flush_interval <= 0
+                or not math.isfinite(close_timeout) or close_timeout <= 0):
+            raise ValueError('Invalid writer capacity, rotation or timing')
+        self.directory = Path(directory)
+        self.directory.mkdir(parents=True, exist_ok=True)
+        self.queue = queue.Queue(maxsize=int(queue_capacity))
+        self.limit = int(max_segment_bytes)
+        self.flush_interval, self.close_timeout = flush_interval, close_timeout
+        self.closing = threading.Event()
+        self.lock = threading.Lock()
+        self.metrics = {'accepted': 0, 'written': 0, 'dropped': 0, 'write_errors': 0,
+                        'queue_highwater': 0, 'flush_count': 0, 'last_error': None,
+                        'segments': [], 'by_stream': {}, 'clean_close': False, 'close_timed_out':False, 'oversized_rows':0}
+        self.handles, self.indices, self.sizes = {}, {}, {}
+        self.thread = threading.Thread(target=self._run, name='diagnostic-jsonl-writer', daemon=True)
+        self.thread.start()
+
+    def submit(self, stream, row):
+        with self.lock:
+            if self.closing.is_set():
+                self.metrics['dropped'] += 1
+                return False
+            try:
+                self.queue.put_nowait((stream, row))
+            except queue.Full:
+                self.metrics['dropped'] += 1
+                return False
+            self.metrics['accepted'] += 1
+            self.metrics['queue_highwater'] = max(self.metrics['queue_highwater'], self.queue.qsize())
+        return True
+
+    def stats(self):
+        with self.lock:
+            result = json_safe(self.metrics)
+        result['queue_depth'] = self.queue.qsize()
+        result['pending_rows'] = self.queue.unfinished_tasks
+        result['writer_alive'] = self.thread.is_alive()
+        return result
+
+    def _open(self, stream):
+        index = self.indices.get(stream, 0)
+        name = f'{stream}.jsonl' if index == 0 else f'{stream}_{index:06d}.jsonl'
+        handle = open(self.directory/name, 'a', encoding='utf-8')
+        self.handles[stream], self.sizes[stream] = handle, 0
+        with self.lock:
+            self.metrics['segments'].append({'stream': stream, 'index': index, 'path': name, 'bytes': 0, 'rows': 0})
+        return handle
+
+    def _write(self, stream, row):
+        line = strict_json(row)+'\n'
+        size = len(line.encode('utf-8'))
+        if size > self.limit:
+            with self.lock:
+                self.metrics['oversized_rows'] += 1
+        if stream in self.handles and self.sizes[stream] and self.sizes[stream]+size > self.limit:
+            self.handles.pop(stream).close()
+            self.indices[stream] = self.indices.get(stream, 0)+1
+        handle = self.handles.get(stream) or self._open(stream)
+        handle.write(line)
+        self.sizes[stream] += size
+        with self.lock:
+            self.metrics['written'] += 1
+            self.metrics['by_stream'][stream] = self.metrics['by_stream'].get(stream, 0)+1
+            for segment in reversed(self.metrics['segments']):
+                if segment['stream'] == stream:
+                    segment['bytes'] += size
+                    segment['rows'] += 1
+                    break
+
+    def _flush(self):
+        for handle in self.handles.values():
+            handle.flush()
+        with self.lock:
+            self.metrics['flush_count'] += 1
+
+    def _error(self, exc):
+        with self.lock:
+            self.metrics['write_errors'] += 1
+            self.metrics['last_error'] = f'{type(exc).__name__}: {exc}'
+
+    def _save_summary(self, clean):
+        with self.lock:
+            self.metrics['clean_close'] = clean
+            summary = json_safe(self.metrics)
+        summary['queue_depth'] = self.queue.qsize()
+        summary['pending_rows'] = self.queue.unfinished_tasks
+        try:
+            (self.directory/'writer_summary.json').write_text(strict_json(summary), encoding='utf-8')
+        except Exception as exc:
+            self._error(exc)
+
+    def _run(self):
+        last_flush = time.monotonic()
+        for stream in ('messages','snapshots','events'):
+            try:
+                self._open(stream)
+            except Exception as exc:
+                self._error(exc)
+        while not self.closing.is_set() or not self.queue.empty():
+            try:
+                stream, row = self.queue.get(timeout=min(.1, self.flush_interval))
+            except queue.Empty:
+                pass
+            else:
+                try:
+                    self._write(stream, row)
+                except Exception as exc:
+                    self._error(exc)
+                finally:
+                    self.queue.task_done()
+            if time.monotonic()-last_flush >= self.flush_interval:
+                try:
+                    self._flush()
+                except Exception as exc:
+                    self._error(exc)
+                last_flush = time.monotonic()
+        try:
+            self._flush()
+            for handle in self.handles.values():
+                handle.close()
+        except Exception as exc:
+            self._error(exc)
+        self._save_summary(self.queue.empty() and self.metrics['write_errors'] == 0 and not self.metrics['close_timed_out'])
+
+    def close(self):
+        self.closing.set()
+        self.thread.join(timeout=self.close_timeout)
+        if self.thread.is_alive():
+            with self.lock:
+                self.metrics['close_timed_out'] = True
+            self._save_summary(False)
+        return self.stats()
+
