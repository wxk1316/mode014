+def matlab_colon(start: float, step: float, stop: float):
+    """MATLAB a:step:b 语义（含端点，按算术序列累加）。"""
+    out = []
+    v = start
+    if step > 0:
+        while v <= stop:
+            out.append(v)
+            v = start + len(out) * step
+    elif step < 0:
+        while v >= stop:
+            out.append(v)
+            v = start + len(out) * step
+    else:
+        raise ValueError('step must be nonzero')
+    return out
+
