+class InputStampGuard:
+    """A repeated source stamp cannot renew validity, even when republished at 50 Hz."""
+    def __init__(self, timeout: float, future_tolerance: float = 0.2):
+        self.timeout = timeout
+        self.future_tolerance = future_tolerance
+        self.stamp = None
+        self.received = -math.inf
+
+    def accept(self, stamp: float, source_now: float, received_now: float) -> bool:
+        if not all(math.isfinite(v) for v in (stamp, source_now, received_now)):
+            return False
+        age = source_now - stamp
+        if stamp <= 0 or age < -self.future_tolerance or age > self.timeout:
+            return False
+        if self.stamp is not None and stamp <= self.stamp:
+            return False
+        self.stamp, self.received = stamp, received_now
+        return True
+
+    def fresh(self, source_now: float, received_now: float) -> bool:
+        return (self.stamp is not None
+                and -self.future_tolerance <= source_now - self.stamp <= self.timeout
+                and 0 <= received_now - self.received <= self.timeout)
