+#include "../control/car_ctr/src/mode_switch_guard.hpp"
+#include <cassert>
+#include <iostream>
+int main() {
+    ModeSwitchGuard g;
+    g.validate();
+    ModeSwitchGuard retry;
+    retry.request(4,0);
+    assert(retry.should_retry(0)); // first transmission is immediate
+    retry.mark_sent(0);
+    retry.observe(0,0.5);
+    assert(!retry.should_retry(.5));
+    assert(!retry.should_retry(3.49));
+    retry.observe(0,3.5);
+    assert(retry.should_retry(3.5)); // one dropped packet may retry after full travel
+    retry.mark_sent(3.5);
+    assert(!retry.should_retry(4.0));
+    retry.observe(4,3.6);
+    assert(!retry.ready(3.6)); // a retry may restart physical wheel travel
+    retry.observe(4,6.5);
+    assert(retry.ready(6.5));
+    retry.observe(1,7.0);
+    assert(!retry.should_retry(7.0)); // fresh intermediate state: do not restart wheels
+    retry.observe(0,7.1);
+    assert(retry.should_retry(7.1));
+    retry.retry_period = 2.9;
+    bool rejected = false;
+    try { retry.validate(); } catch (const std::invalid_argument &) { rejected = true; }
+    assert(rejected);
+    assert(g.request(4,0));
+    g.observe(0,0);
+    assert(!g.ready(0));
+    assert(!g.request(0,1)); // in-flight request cannot reverse
+    g.observe(4,2.99);
+    assert(!g.ready(2.99));
+    assert(g.ready(3.0)); // feedback does not add another three seconds
+    assert(g.ready_mode(3.0)==4);
+    assert(!g.ready(3.31)); // stale feedback cannot authorize motion
+    g.observe(4,3.5);
+    assert(g.ready(3.5));
+    assert(g.request(0,3.5));
+    assert(!g.ready(3.5));
+    g.observe(0,6.49);
+    assert(!g.ready(6.49));
+    assert(g.ready(6.5));
+    assert(g.ready_mode(6.5)==0);
+    assert(g.command_mode(2)==-1);
+    assert(g.command_mode(4)==4);
+    assert(g.command_mode(1)==-1);
+    ModeSwitchGuard legacy;
+    legacy.spin_feedback_mode=2;
+    legacy.validate();
+    assert(legacy.command_mode(2)==4);
+    ModeSwitchGuard alternate;
+    alternate.spin_feedback_mode = 4;
+    alternate.validate();
+    alternate.request(4,0);
+    alternate.mark_sent(0);
+    alternate.observe(2,3);
+    assert(!alternate.ready(3)); // do not silently accept both protocol IDs
+    alternate.observe(4,3.1);
+    assert(alternate.ready(3.1));
+    assert(alternate.command_mode(4)==4);
+    std::cout << "mode switch guard passed: one 3s wait, mapping, stale feedback, lock, safe retry cadence\n";
+}
