+class ReferencePairBuffer:
+    """Only commit a stamped command and Path from the same planning epoch."""
+    def __init__(self, capacity=4):
+        self.capacity = capacity
+        self.commands, self.paths = {}, {}
+        self.last_epoch = -1
+
+    def _insert(self, store, epoch, payload):
+        if epoch <= 0 or epoch <= self.last_epoch:
+            return None
+        store[epoch] = payload
+        while len(store) > self.capacity:
+            del store[min(store)]
+        if epoch not in self.commands or epoch not in self.paths:
+            return None
+        v, w, command_receipt = self.commands[epoch]
+        points, path_receipt = self.paths[epoch]
+        self.last_epoch = epoch
+        self.commands = {k:v for k,v in self.commands.items() if k > epoch}
+        self.paths = {k:v for k,v in self.paths.items() if k > epoch}
+        return (epoch, v, w, points, min(command_receipt, path_receipt))
+
+    def command(self, epoch, v, w, received):
+        return self._insert(self.commands, epoch, (v, w, received))
+
+    def path(self, epoch, points, received):
+        return self._insert(self.paths, epoch, (points, received))
 
 
