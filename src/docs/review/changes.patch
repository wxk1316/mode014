+"""Offline control regressions; never imports ROS or opens a socket."""
+import math
+import sys
+import unittest
+from pathlib import Path
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]/'rda_dwa_real'))
+from rda_dwa_real.traj_tracker_core import TrajTrackerCore, TrajTrackerParams, InputStampGuard, ReferencePairBuffer, PoseContinuityGuard
+
+class ControlTests(unittest.TestCase):
+    def setUp(self):
+        self.c = TrajTrackerCore()
+        self.traj = [(i*.02, 0.) for i in range(60)]
+        self.c.set_pose(0, 0)
+        self.t = 0.
+
+    def tick(self, yaw=0., target=math.pi/2, v=0., w=0., ready=None):
+        self.t += .02
+        if ready is not None:
+            self.c.set_mode_ready(ready, self.t)
+        return self.c.step(v, w, yaw, self.traj, target, self.t, .02, 1)
+
+    def request(self):
+        self.c.set_traj_mode(1)
+        for _ in range(16):
+            self.tick(ready=0)
+        self.assertEqual(self.c.mode, self.c.MODE_SPIN)
+
+    def run_spin(self):
+        self.request()
+        for _ in range(160):
+            out = self.tick(ready=4)
+        self.assertEqual(self.c._spin_stage, 'RUN')
+        return out
+
+    def test_w_zero_still_rotates_after_ready(self):
+        out = self.run_spin()
+        self.assertEqual(out['turnmode'], 4)
+        self.assertGreater(out['speed'], 0.)
+
+    def test_three_second_hold_and_ready_gate(self):
+        self.request()
+        for _ in range(150):
+            out = self.tick(ready=-1)
+            self.assertEqual(out['speed'], 0.)
+        self.assertEqual(self.c._spin_stage, 'HOLD')
+        out = self.tick(ready=4)
+        self.assertEqual(self.c._spin_stage, 'RUN')
+        self.assertGreater(out['speed'], 0.)
+        self.assertAlmostEqual(self.c._spin_run_since, self.t)
+
+    def test_switch_failure_is_latched(self):
+        self.request()
+        for _ in range(450):
+            out = self.tick(ready=-1)
+        self.assertEqual(self.c.mode, self.c.MODE_FAULT)
+        self.assertEqual(self.c.bridge_state(), 4)
+        self.assertEqual(out['turnmode'], 4)
+        self.assertEqual(out['speed'], 0.)
+
+    def test_local_session_target_latched(self):
+        self.run_spin()
+        out = self.tick(target=-math.pi/2, ready=4)
+        self.assertGreater(out['speed'], 0.)
+
+    def test_mode_zero_cannot_claim_spin_completion(self):
+        self.run_spin()
+        self.c.set_traj_mode(0)
+        out = self.tick(ready=4)
+        self.assertEqual(self.c.mode, self.c.MODE_SPIN)
+        self.assertGreater(out['speed'], 0.)
+
+    def test_abort_holds_wheel_mode_and_failure(self):
+        self.run_spin()
+        self.c.set_traj_mode(-1)
+        out = self.tick(ready=4)
+        self.assertEqual(out['turnmode'], 4)
+        self.assertEqual(out['speed'], 0.)
+        self.assertEqual(self.c.bridge_state(), 4)
+        self.c.set_traj_mode(1)
+        out = self.tick(ready=4)
+        self.assertEqual(self.c.mode, self.c.MODE_FAULT)
+        self.assertEqual(out['speed'], 0.)
+
+    def test_input_stop_does_not_switch_to_ack(self):
+        self.run_spin()
+        out = self.c.safety_stop('localization_timeout', self.t)
+        self.assertEqual(out['turnmode'], 4)
+        self.assertEqual(out['speed'], 0.)
+        self.assertEqual(self.c._failure_reason, 'localization_timeout')
+
+    def test_yaw_progress_timeout(self):
+        self.run_spin()
+        for _ in range(110):
+            out = self.tick(ready=4)
+        self.assertEqual(self.c._failure_reason, 'spin_no_yaw_progress')
+        self.assertEqual(out['speed'], 0.)
+
+    def test_feedback_loss_during_run_aborts(self):
+        self.run_spin()
+        out = self.tick(ready=-1)
+        self.assertEqual(out['speed'], 0.)
+        self.assertEqual(self.c.mode, self.c.MODE_FAULT)
+
+    def test_reached_waits_for_stable_yaw_and_ack_ready(self):
+        self.run_spin()
+        for _ in range(16):
+            out = self.tick(yaw=math.pi/2, ready=4)
+        self.assertEqual(self.c.mode, self.c.MODE_STOP)
+        self.assertEqual(self.c.bridge_state(), 3)
+        for _ in range(30):
+            self.tick(yaw=math.pi/2, ready=4)
+        self.assertEqual(self.c.mode, self.c.MODE_REC)
+        self.assertEqual(self.c.bridge_state(), 3)
+        for _ in range(160):
+            out = self.tick(yaw=math.pi/2, ready=-1)
+        self.assertEqual(self.c.mode, self.c.MODE_REC)
+        self.assertEqual(out['speed'], 0.)
+        self.tick(yaw=math.pi/2, ready=0)
+        self.assertEqual(self.c.mode, self.c.MODE_ACK)
+        # A repeated 1 cannot start the completed session again.
+        for _ in range(20):
+            self.tick(yaw=math.pi/2, ready=0)
+        self.assertEqual(self.c.mode, self.c.MODE_ACK)
+
+    def test_abort_recovery_requires_zero_and_physical_ready(self):
+        self.run_spin()
+        self.c.safety_stop('fault', self.t)
+        self.c.set_traj_mode(0)
+        out = self.tick(ready=4)
+        self.assertEqual(self.c.mode, self.c.MODE_REC)
+        self.assertEqual(out['turnmode'], 0)
+        self.assertEqual(self.c.bridge_state(), 4)
+        for _ in range(155):
+            self.tick(ready=-1)
+        self.assertEqual(self.c.mode, self.c.MODE_REC)
+        self.tick(ready=0)
+        self.assertEqual(self.c.mode, self.c.MODE_ACK)
+
+    def test_new_reference_resets_nearest_index(self):
+        self.assertEqual(self.c._nearest_index(self.traj, .4, 0, 1), 20)
+        self.assertEqual(self.c._nearest_index(self.traj, 0, 0, 2), 0)
+        self.assertEqual(self.c._nearest_index(self.traj, .2, 0, 2), 10)
