+        setattr(stubs['rclpy.qos'],key,object)
+    for parent,names in [('geometry_msgs.msg',('Twist','TwistStamped')),
+                         ('nav_msgs.msg',('Odometry','Path')),
+                         ('std_msgs.msg',('String','Int32','Float32')),
+                         ('control_msgs.msg',('CarCtr','CarState'))]:
+        for name in names: setattr(stubs[parent],name,object)
+    module_name='rda_dwa_real._tracker_contract'
+    path=Path(__file__).resolve().parents[1]/'rda_dwa_real/rda_dwa_real/traj_tracker_node.py'
+    spec=importlib.util.spec_from_file_location(module_name,path)
+    module=importlib.util.module_from_spec(spec)
