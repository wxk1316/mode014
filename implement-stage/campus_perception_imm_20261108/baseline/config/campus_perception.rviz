Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: map
    Background Color: 35; 35; 35
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground reference
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 30
    - Class: rviz_default_plugins/PointCloud2
      Name: LiDAR
      Enabled: true
      Topic:
        Value: /rslidar_points
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Color Transformer: Intensity
      Position Transformer: XYZ
      Style: Points
      Size (Pixels): 2
    - Class: rviz_default_plugins/MarkerArray
      Name: Tracked obstacles
      Enabled: true
      Marker Topic:
        Value: /rda/obstacles_markers
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/Map
      Name: Drivable occupancy
      Enabled: true
      Topic:
        Value: /rda/drivable_area
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Alpha: 0.5
      Color Scheme: map
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Target Frame: base_link
      Distance: 20
      Pitch: 0.8
      Yaw: 0.7
Window Geometry:
  Width: 1280
  Height: 800
